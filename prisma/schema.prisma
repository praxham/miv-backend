// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  emailId      String   @unique @map("email_id")
  otp          String   @unique
  otpExpiresAt DateTime
  upiId        String?  @map("upi_id")
  role         String   @default("buyer")
  username     String?  @unique
  profilePhoto String?  @map("profile_photo")
  waNumber     String?  @map("wa_number")
  description  String?
  socials      String?  @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Inverse Relations
  artifacts Artifact[] @relation("ArtistArtifacts")
  sales     Order[]    @relation("SellerOrders")
  purchases Order[]    @relation("BuyerOrders")

  @@map("users")
}

model Artifact {
  id                     String   @id @default(uuid())
  byArtist               String   @map("by_artist")
  slug                   String   @unique
  images                 String   @default("[]")
  title                  String
  category               String
  description            String
  amount                 Int
  deliverableFileFormats String   @default("[]") @map("deliverable_file_formats")
  deliverableFiles       String   @default("[]") @map("deliverable_files")
  isPublished            String   @default("false") @map("is_published")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  // Relations
  artist User    @relation("ArtistArtifacts", fields: [byArtist], references: [id])
  orders Order[]

  @@map("artifacts")
}

model Order {
  id            String   @id @default(uuid())
  artifactId    String   @map("artifact")
  soldById      String   @map("sold_by")
  boughtById    String   @map("bought_by")
  sellerUpiId   String   @map("seller_upi_id")
  buyerUpiId    String   @map("buyer_upi_id")
  amount        Int
  utrNumber     String   @map("utr_number")
  paymentStatus String   @default("pending_seller_confirmation") @map("payment_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  artifact Artifact @relation(fields: [artifactId], references: [id])
  seller   User     @relation("SellerOrders", fields: [soldById], references: [id])
  buyer    User     @relation("BuyerOrders", fields: [boughtById], references: [id])

  @@map("orders")
}
